{
  "name": "react-native-capture-and-share",
  "version": "1.0.0",
  "description": "Capture any view and share it via a bottom tray with a carousel of direct-share targets.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__mocks__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "prepare": "bob build",
    "build": "bob build",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify-pack": "node scripts/verify-pack-contents.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "share",
    "screenshot",
    "capture"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@expo/vector-icons": "*",
    "@gorhom/bottom-sheet": "*",
    "expo": "*",
    "expo-asset": "*",
    "expo-clipboard": "*",
    "expo-font": "*",
    "expo-linear-gradient": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-share": "*",
    "react-native-view-shot": "*",
    "react-native-worklets": "*"
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.15",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-share": "^12.3.1",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.0",
    "test-renderer": "1.2",
    "typescript": "~6.0.3"
  },
  "private": false,
  "jest": {
    "preset": "jest-expo"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__/**,__fixtures__/**,__mocks__/**,*.test.ts,*.test.tsx}",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
